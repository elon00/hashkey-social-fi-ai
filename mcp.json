{
  "mcpServers": {
    "hashkey-social-fi-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "HashKey Chain",
        "PROJECT_TICKER": "HKSOCIAL"
      },
      "tools": [
        {
          "name": "verify_hksocial_invariants",
          "description": "Verifies deterministic invariants for HashKey SocialFi AI on HashKey Chain."
        },
        {
          "name": "execute_hksocial_action",
          "description": "Executes authenticated SocialFi state transition."
        }
      ]
    }
  }
}